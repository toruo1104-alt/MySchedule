{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myschedule",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myschedule-db",
      "database_id": "TBD-初回構築時に転記"
    }
  ]
}
